digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#E6550D" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#74C476" ]
  obj [ label="visual\nobjects"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  data -> vis [ color="#FD8D3C;0.1:#EE9342;0.1:#DF9949;0.1:#CF9F4F;0.1:#C0A556;0.1:#B1AC5C;0.1:#A2B263;0.1:#92B869;0.1:#83BE70;0.1:#74C476;0.1" ]
  vis -> obj [ color="#74C476;0.1:#67BA6E;0.1:#5AB166;0.1:#4DA75D;0.1:#409D55;0.1:#34944D;0.1:#278A45;0.1:#1A803C;0.1:#0D7734;0.1:#006D2C;0.1" ]
  obj:s -> stat:se [ style="dashed", color="#006D2C;0.1:#1A6A29;0.1:#336825;0.1:#4D6522;0.1:#66621E;0.1:#80601B;0.1:#995D17;0.1:#B35A14;0.1:#CC5810;0.1:#E6550D;0.1" ]
{ rank=same; data, stat }
{ rank=same; vis, obj }
}
