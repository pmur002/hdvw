digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#F09736" ]
  lie [ label="garbage\nand lies"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#EC6184" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00B19B" ]
  data -> lie [ color="#F09736;0.1:#F0913F;0.1:#EF8B47;0.1:#EF8550;0.1:#EE7F59;0.1:#EE7961;0.1:#ED736A;0.1:#ED6D73;0.1:#EC677B;0.1:#EC6184;0.1" ]
  lie -> vis [ color="#EC6184;0.1:#D26A87;0.1:#B87389;0.1:#9D7C8C;0.1:#83858E;0.1:#698D91;0.1:#4F9693;0.1:#349F96;0.1:#1AA898;0.1:#00B19B;0.1" ]
  vis:s -> lie:se [ style="dashed", color="#00B19B;0.1:#1AA898;0.1:#349F96;0.1:#4F9693;0.1:#698D91;0.1:#83858E;0.1:#9D7C8C;0.1:#B87389;0.1:#D26A87;0.1:#EC6184;0.1" ]
{ rank=same; data, lie }
}
