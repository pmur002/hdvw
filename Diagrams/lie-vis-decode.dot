digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  lie [ label="garbage\nand lies"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FB6A4A" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#74C476" ]
  data -> lie [ color="#FD8D3C;0.1:#FD893E;0.1:#FD853F;0.1:#FC8141;0.1:#FC7D42;0.1:#FC7A44;0.1:#FC7645;0.1:#FB7247;0.1:#FB6E48;0.1:#FB6A4A;0.1" ]
  lie -> vis [ color="#FB6A4A;0.1:#EC744F;0.1:#DD7E54;0.1:#CE8859;0.1:#BF925E;0.1:#B09C62;0.1:#A1A667;0.1:#92B06C;0.1:#83BA71;0.1:#74C476;0.1" ]
  vis:s -> lie:se [ style="dashed", color="#74C476;0.1:#83BA71;0.1:#92B06C;0.1:#A1A667;0.1:#B09C62;0.1:#BF925E;0.1:#CE8859;0.1:#DD7E54;0.1:#EC744F;0.1:#FB6A4A;0.1" ]
{ rank=same; data, lie }
}
