digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006400" ]
  lie [ label="garbage\nand lies"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#A40244" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#005FB2" ]
  data -> lie [ color="#006400;0.1:#125908;0.1:#244E0F;0.1:#374317;0.1:#49381E;0.1:#5B2E26;0.1:#6D232D;0.1:#801835;0.1:#920D3C;0.1:#A40244;0.1" ]
  lie -> vis [ color="#A40244;0.1:#920C50;0.1:#80175C;0.1:#6D2169;0.1:#5B2B75;0.1:#493681;0.1:#37408D;0.1:#244A9A;0.1:#1255A6;0.1:#005FB2;0.1" ]
  vis:s -> lie:se [ style="dashed", color="#005FB2;0.1:#1255A6;0.1:#244A9A;0.1:#37408D;0.1:#493681;0.1:#5B2B75;0.1:#6D2169;0.1:#80175C;0.1:#920C50;0.1:#A40244;0.1" ]
{ rank=same; data, lie }
}
