digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  lie [ label="garbage\nand lies"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#969696" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="rounded"; color="#74C476"; fontcolor="#74C476" ]
  data -> lie [ style="solid"; penwidth=1; color="#FD8D3C;0.1:#F28E46;0.1:#E68F50;0.1:#DB905A;0.1:#CF9164;0.1:#C4926E;0.1:#B89378;0.1:#AD9482;0.1:#A1958C;0.1:#969696;0.1" ]
  lie -> vis [ style="bold"; penwidth=1; color="#969696;0.1:#929B92;0.1:#8EA08F;0.1:#8BA58B;0.1:#87AA88;0.1:#83B084;0.1:#7FB581;0.1:#7CBA7D;0.1:#78BF7A;0.1:#74C476;0.1" ]
  vis:s -> lie:se [ style="solid", color="#74C476;0.1:#78BF7A;0.1:#7CBA7D;0.1:#7FB581;0.1:#83B084;0.1:#87AA88;0.1:#8BA58B;0.1:#8EA08F;0.1:#929B92;0.1:#969696;0.1" ]
{ rank=same; data, lie }
}
