digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  lie [ label="garbage\nand lies"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#969696" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="rounded"; color="#006D2C"; fontcolor="#006D2C" ]
  data -> lie [ style="solid"; penwidth=1; color="#006D2C;0.1:#117238;0.1:#217644;0.1:#327B4F;0.1:#437F5B;0.1:#538467;0.1:#648873;0.1:#758D7E;0.1:#85918A;0.1:#969696;0.1" ]
  lie -> vis [ style="bold"; penwidth=1; color="#969696;0.1:#85918A;0.1:#758D7E;0.1:#648873;0.1:#538467;0.1:#437F5B;0.1:#327B4F;0.1:#217644;0.1:#117238;0.1:#006D2C;0.1" ]
  vis:s -> lie:se [ style="dashed", color="#006D2C;0.1:#117238;0.1:#217644;0.1:#327B4F;0.1:#437F5B;0.1:#538467;0.1:#648873;0.1:#758D7E;0.1:#85918A;0.1:#969696;0.1" ]
{ rank=same; data, lie }
}
