digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#E6550D" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="rounded"; color="#74C476"; fontcolor="#74C476" ]
  data -> stat [ style="solid"; penwidth=1; color="#FD8D3C;0.1:#FA8737;0.1:#F88132;0.1:#F57A2C;0.1:#F37427;0.1:#F06E22;0.1:#EE681D;0.1:#EB6117;0.1:#E95B12;0.1:#E6550D;0.1" ]
  stat -> vis [ style="bold"; penwidth=1; color="#E6550D;0.1:#D96119;0.1:#CD6E24;0.1:#C07A30;0.1:#B3863C;0.1:#A79347;0.1:#9A9F53;0.1:#8DAB5F;0.1:#81B86A;0.1:#74C476;0.1" ]
  vis:s -> stat:se [ style="solid", color="#74C476;0.1:#81B86A;0.1:#8DAB5F;0.1:#9A9F53;0.1:#A79347;0.1:#B3863C;0.1:#C07A30;0.1:#CD6E24;0.1:#D96119;0.1:#E6550D;0.1" ]
{ rank=same; data, stat }
}
