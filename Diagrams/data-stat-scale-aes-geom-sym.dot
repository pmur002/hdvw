digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006400" ]
  ggstat [ label="stats"; shape=box; style=rounded; color="#006400"; fontcolor="#006400" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006400" ]
  scale [ label="scales"; shape=box; style=rounded; color="#005FB2"; fontcolor="#005FB2" ]
  aes [ label="aesthetics"; shape=box; style=rounded; color="#005FB2"; fontcolor="#005FB2" ]
  geom [ label="geoms"; shape=box; style=rounded; color="#005FB2"; fontcolor="#005FB2" ]
  sym [ label="data\nsymbols"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#005FB2" ]
  data -> ggstat [ color="#006400" ]
  ggstat -> stat [ color="#006400" ]
  stat -> scale [ color="#006400;0.1:#006314;0.1:#006328;0.1:#00623B;0.1:#00624F;0.1:#006163;0.1:#006177;0.1:#00608A;0.1:#00609E;0.1:#005FB2;0.1" ]
  scale -> aes [ color="#005FB2" ]
  aes -> geom [ color="#005FB2" ]
  geom -> sym [ color="#005FB2" ]
}
