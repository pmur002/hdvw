digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  ggstat [ label="stats"; shape=box; style=rounded; color="#FD8D3C"; fontcolor="#FD8D3C" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#E6550D" ]
  scale [ label="scales"; shape=box; style=rounded; color="#74C476"; fontcolor="#74C476" ]
  aes [ label="aesthetics"; shape=box; style=rounded; color="#74C476"; fontcolor="#74C476" ]
  geom [ label="geoms"; shape=box; style=rounded; color="#74C476"; fontcolor="#74C476" ]
  sym [ label="data\nsymbols"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#74C476" ]
  data -> ggstat [ color="#FD8D3C" ]
  ggstat -> stat [ color="#FD8D3C" ]
  stat -> scale [ color="#FD8D3C;0.1:#EE9342;0.1:#DF9949;0.1:#CF9F4F;0.1:#C0A556;0.1:#B1AC5C;0.1:#A2B263;0.1:#92B869;0.1:#83BE70;0.1:#74C476;0.1" ]
  scale -> aes [ color="#74C476" ]
  aes -> geom [ color="#74C476" ]
  geom -> sym [ color="#74C476" ]
}
