digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#F09736" ]
  ggstat [ label="stats"; shape=box; style=rounded; color="#F09736"; fontcolor="#F09736" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#F09736" ]
  scale [ label="scales"; shape=box; style=rounded; color="#00B19B"; fontcolor="#00B19B" ]
  aes [ label="aesthetics"; shape=box; style=rounded; color="#00B19B"; fontcolor="#00B19B" ]
  geom [ label="geoms"; shape=box; style=rounded; color="#00B19B"; fontcolor="#00B19B" ]
  sym [ label="data\nsymbols"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00B19B" ]
  data -> ggstat [ color="#F09736" ]
  ggstat -> stat [ color="#F09736" ]
  stat -> scale [ color="#F09736;0.1:#D59A41;0.1:#BB9D4C;0.1:#A0A058;0.1:#85A363;0.1:#6BA56E;0.1:#50A879;0.1:#35AB85;0.1:#1BAE90;0.1:#00B19B;0.1" ]
  scale -> aes [ color="#00B19B" ]
  aes -> geom [ color="#00B19B" ]
  geom -> sym [ color="#00B19B" ]
}
