digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  eye [ label="eye"; shape=none; ]
  basic [ label="visual\nfeatures"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#005FB2" ]
  shapes [ label="visual\nshapes"; shape=box;
        style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#005FB2" ]
  objects [ label="visual\nobjects"; shape=box;
         style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#005FB2" ]
  eye -> basic [ color="#000000;0.1:#000B14;0.1:#001528;0.1:#00203B;0.1:#002A4F;0.1:#003563;0.1:#003F77;0.1:#004A8A;0.1:#00549E;0.1:#005FB2;0.1" ]
  basic -> shapes [ color="#005FB2" ]
  shapes -> objects [ color="#005FB2" ]
}
