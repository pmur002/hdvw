digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  eye [ label="eye"; shape=none; ]
  basic [ label="visual\nfeatures"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#74C476" ]
  shapes [ label="visual\nshapes"; shape=box;
        style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#31A354" ]
  objects [ label="visual\nobjects"; shape=box;
         style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  eye -> basic [ color="#000000;0.1:#0D160D;0.1:#1A2C1A;0.1:#274127;0.1:#345734;0.1:#406D42;0.1:#4D834F;0.1:#5A985C;0.1:#67AE69;0.1:#74C476;0.1" ]
  basic -> shapes [ color="#74C476;0.1:#6DC072;0.1:#65BD6E;0.1:#5EB96B;0.1:#56B567;0.1:#4FB263;0.1:#47AE5F;0.1:#40AA5C;0.1:#38A758;0.1:#31A354;0.1" ]
  shapes -> objects [ color="#31A354;0.1:#2C9D50;0.1:#26974B;0.1:#219147;0.1:#1B8B42;0.1:#16853E;0.1:#107F39;0.1:#0B7935;0.1:#057330;0.1:#006D2C;0.1" ]
}
