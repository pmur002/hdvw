digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  eye [ label="eye"; shape=none; ]
  basic [ label="visual\nfeatures"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00B19B" ]
  shapes [ label="visual\nshapes"; shape=box;
        style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00B19B" ]
  objects [ label="visual\nobjects"; shape=box;
         style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00B19B" ]
  eye -> basic [ color="#000000;0.1:#001411;0.1:#002722;0.1:#003B34;0.1:#004F45;0.1:#006256;0.1:#007667;0.1:#008A79;0.1:#009D8A;0.1:#00B19B;0.1" ]
  basic -> shapes [ color="#00B19B" ]
  shapes -> objects [ color="#00B19B" ]
}
