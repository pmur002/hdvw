digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#31A354" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="rounded"; color="#006D2C"; fontcolor="#006D2C" ]
  shape [ label="visual\nshapes"; shape=box;
       style="rounded"; color="#31A354"; fontcolor="#31A354" ]
  obj [ label="visual\nobjects"; shape=box;
     style="rounded"; color="#74C476"; fontcolor="#74C476" ]
  data -> vis [ style="bold"; penwidth=1; color="#006D2C" ]
  vis -> shape [ style="solid", color="#006D2C;0.1:#057330;0.1:#0B7935;0.1:#107F39;0.1:#16853E;0.1:#1B8B42;0.1:#219147;0.1:#26974B;0.1:#2C9D50;0.1:#31A354;0.1" ]
  shape -> obj [ style="solid", color="#31A354;0.1:#38A758;0.1:#40AA5C;0.1:#47AE5F;0.1:#4FB263;0.1:#56B567;0.1:#5EB96B;0.1:#65BD6E;0.1:#6DC072;0.1:#74C476;0.1" ]
  obj:s -> stat:se [ style="dashed", color="#74C476;0.1:#6DC072;0.1:#65BD6E;0.1:#5EB96B;0.1:#56B567;0.1:#4FB263;0.1:#47AE5F;0.1:#40AA5C;0.1:#38A758;0.1:#31A354;0.1" ]
{ rank=same; data, stat }
{ rank=same; vis, shape, obj }
}
