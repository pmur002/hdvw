digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#F09736" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#A86505" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00B19B" ]
  shape [ label="visual\nshapes"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00796A" ]
  obj [ label="visual\nobjects"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#07544A" ]
  data -> vis [ color="#F09736;0.1:#D59A41;0.1:#BB9D4C;0.1:#A0A058;0.1:#85A363;0.1:#6BA56E;0.1:#50A879;0.1:#35AB85;0.1:#1BAE90;0.1:#00B19B;0.1" ]
  vis -> shape [ color="#00B19B;0.1:#00AB96;0.1:#00A590;0.1:#009E8B;0.1:#009885;0.1:#009280;0.1:#008C7A;0.1:#008575;0.1:#007F6F;0.1:#00796A;0.1" ]
  shape -> obj [ color="#00796A;0.1:#017566;0.1:#027163;0.1:#026D5F;0.1:#03695C;0.1:#046458;0.1:#056055;0.1:#055C51;0.1:#06584E;0.1:#07544A;0.1" ]
  obj:s -> stat:se [ style="dashed", color="#07544A;0.1:#195642;0.1:#2B583B;0.1:#3D5A33;0.1:#4F5C2B;0.1:#605D24;0.1:#725F1C;0.1:#846114;0.1:#96630D;0.1:#A86505;0.1" ]
{ rank=same; data, stat }
{ rank=same; vis, shape, obj }
}
