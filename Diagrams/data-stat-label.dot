digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#E6550D" ]
  label [ label="text\nlabel"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  data -> stat [ color="#FD8D3C;0.1:#FA8737;0.1:#F88132;0.1:#F57A2C;0.1:#F37427;0.1:#F06E22;0.1:#EE681D;0.1:#EB6117;0.1:#E95B12;0.1:#E6550D;0.1" ]
  stat -> label [ color="#E6550D;0.1:#CC5810;0.1:#B35A14;0.1:#995D17;0.1:#80601B;0.1:#66621E;0.1:#4D6522;0.1:#336825;0.1:#1A6A29;0.1:#006D2C;0.1" ]
  label:s -> stat:se [ style="dashed", color="#006D2C;0.1:#1A6A29;0.1:#336825;0.1:#4D6522;0.1:#66621E;0.1:#80601B;0.1:#995D17;0.1:#B35A14;0.1:#CC5810;0.1:#E6550D;0.1" ]
{ rank=same; data, stat }
}
