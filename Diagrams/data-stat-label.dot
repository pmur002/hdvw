digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#F09736" ]
  stat [ label="data\nsummaries"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#A86505" ]
  label [ label="text\nlabel"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#07544A" ]
  data -> stat [ color="#F09736;0.1:#E89131;0.1:#E08C2B;0.1:#D88626;0.1:#D08120;0.1:#C87B1B;0.1:#C07615;0.1:#B87010;0.1:#B06B0A;0.1:#A86505;0.1" ]
  stat -> label [ color="#A86505;0.1:#96630D;0.1:#846114;0.1:#725F1C;0.1:#605D24;0.1:#4F5C2B;0.1:#3D5A33;0.1:#2B583B;0.1:#195642;0.1:#07544A;0.1" ]
  label:s -> stat:se [ style="dashed", color="#07544A;0.1:#195642;0.1:#2B583B;0.1:#3D5A33;0.1:#4F5C2B;0.1:#605D24;0.1:#725F1C;0.1:#846114;0.1:#96630D;0.1:#A86505;0.1" ]
{ rank=same; data, stat }
}
