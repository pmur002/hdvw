digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  meta [ label="metadata /\nbackground"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#F09736" ]
  label [ label="text\nlabel"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#07544A" ]
  meta -> label [ color="#F09736;0.1:#D69038;0.1:#BC883A;0.1:#A2813D;0.1:#88793F;0.1:#6F7241;0.1:#556A43;0.1:#3B6346;0.1:#215B48;0.1:#07544A;0.1" ]
  label:s -> meta:se [ style="dashed", color="#07544A;0.1:#215B48;0.1:#3B6346;0.1:#556A43;0.1:#6F7241;0.1:#88793F;0.1:#A2813D;0.1:#BC883A;0.1:#D69038;0.1:#F09736;0.1" ]
}
