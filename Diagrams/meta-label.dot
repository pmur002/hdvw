digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  meta [ label="metadata /\nbackground"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#74C476" ]
  label [ label="text\nlabel"; shape=box;
       style="rounded"; color="#74C476"; fontcolor="#74C476" ]
  meta -> label [ style="bold"; penwidth=1; color="#006D2C;0.1:#0D7734;0.1:#1A803C;0.1:#278A45;0.1:#34944D;0.1:#409D55;0.1:#4DA75D;0.1:#5AB166;0.1:#67BA6E;0.1:#74C476;0.1" ]
  label:s -> meta:se [ style="dashed", color="#74C476" ]
}
