digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  meta [ label="metadata /\nbackground"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  label [ label="text\nlabel"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  meta -> label [ color="#FD8D3C;0.1:#E1893A;0.1:#C58638;0.1:#A98237;0.1:#8D7F35;0.1:#707B33;0.1:#547831;0.1:#387430;0.1:#1C712E;0.1:#006D2C;0.1" ]
  label:s -> meta:se [ style="dashed", color="#006D2C;0.1:#1C712E;0.1:#387430;0.1:#547831;0.1:#707B33;0.1:#8D7F35;0.1:#A98237;0.1:#C58638;0.1:#E1893A;0.1:#FD8D3C;0.1" ]
}
