digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  meta [ label="metadata /\nbackground"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#F09736" ]
  label [ label="text\nlabel"; shape=box;
       style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#00B19B" ]
  meta -> label [ color="#F09736;0.1:#D59A41;0.1:#BB9D4C;0.1:#A0A058;0.1:#85A363;0.1:#6BA56E;0.1:#50A879;0.1:#35AB85;0.1:#1BAE90;0.1:#00B19B;0.1" ]
  label:s -> meta:se [ style="dashed", color="#00B19B;0.1:#1BAE90;0.1:#35AB85;0.1:#50A879;0.1:#6BA56E;0.1:#85A363;0.1:#A0A058;0.1:#BB9D4C;0.1:#D59A41;0.1:#F09736;0.1" ]
}
