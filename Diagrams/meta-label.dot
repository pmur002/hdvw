digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  meta [ label="metadata\n"; shape=box; style=filled; fillcolor=gray ]
  label [ label="text\nlabel"; shape=box;
          style=filled; fillcolor="#444444"; fontcolor=white ]
  meta -> label
  label:s -> meta:se [ style="dashed" ]
}
