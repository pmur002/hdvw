digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#74C476" ]
  add [ label="emergent\nfeatures"; shape=box;
     style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#31A354" ]
  data -> vis [ color="#FD8D3C;0.1:#EE9342;0.1:#DF9949;0.1:#CF9F4F;0.1:#C0A556;0.1:#B1AC5C;0.1:#A2B263;0.1:#92B869;0.1:#83BE70;0.1:#74C476;0.1" ]
  vis -> add [ color="#74C476;0.1:#6DC072;0.1:#65BD6E;0.1:#5EB96B;0.1:#56B567;0.1:#4FB263;0.1:#47AE5F;0.1:#40AA5C;0.1:#38A758;0.1:#31A354;0.1" ]
{ rank=same; vis, add }
}
