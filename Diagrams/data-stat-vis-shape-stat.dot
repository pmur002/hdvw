digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style=filled; fillcolor=gray ]
  stat [ label="data\nsummaries"; shape=box; style=filled; fillcolor=gray ]
  stat2 [ label="summary\nsummaries"; shape=box; style=filled; fillcolor=gray ]
  vis [ label="visual\nfeatures"; shape=box;
        style=filled; fillcolor="#444444"; fontcolor=white ]
  shape [ label="visual\nshapes"; shape=box;
          style=filled; fillcolor="#444444"; fontcolor=white ]
  data -> stat
  stat -> vis
  vis -> shape
  shape:s -> stat2:se [ style="dashed" ]
{ rank=same; data, stat }
{ rank=same; data, stat2 }
{ rank=same; vis, shape }
}
