digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  imp [ label="importance /\nsignificance"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="rounded"; color="#006D2C"; fontcolor="#006D2C" ]
  imp -> vis [ style="bold"; penwidth=1; color="#006D2C" ]
  vis:s -> imp:se [ style="dashed", color="#006D2C" ]
}
