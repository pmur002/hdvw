digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#FD8D3C" ]
  lie [ label="garbage\nand lies"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#969696" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="rounded"; color="#74C476"; fontcolor="#74C476" ]
  add [ label="emergent\nfeatures"; shape=box;
     style="rounded"; color="#31A354"; fontcolor="#31A354" ]
  data -> vis [ style="bold"; penwidth=1; color="#FD8D3C;0.1:#EE9342;0.1:#DF9949;0.1:#CF9F4F;0.1:#C0A556;0.1:#B1AC5C;0.1:#A2B263;0.1:#92B869;0.1:#83BE70;0.1:#74C476;0.1" ]
  vis -> add [ style="solid", color="#74C476;0.1:#6DC072;0.1:#65BD6E;0.1:#5EB96B;0.1:#56B567;0.1:#4FB263;0.1:#47AE5F;0.1:#40AA5C;0.1:#38A758;0.1:#31A354;0.1" ]
  add:s -> lie:se [ style="solid", color="#31A354;0.1:#479D53;0.1:#5E9652;0.1:#749051;0.1:#8B8A50;0.1:#A1834E;0.1:#B87D4D;0.1:#CE774C;0.1:#E5704B;0.1:#FB6A4A;0.1" ]
{ rank=same; data, lie }
{ rank=same; vis, add }
}
