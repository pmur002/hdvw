digraph {
  graph [ rankdir=LR; margin=.2; nodesep=.5 ];
  node [ fontsize=20; fontname="sans bold"; margin=.2 ];
  diss [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#08519C" ]
  data [ label="data\nvalues"; shape=box; style="filled, rounded"; penwidth=0; fontcolor=white; fillcolor="#006D2C" ]
  vis [ label="visual\nfeatures"; shape=box;
     style="rounded"; color="#006D2C"; fontcolor="#006D2C" ]
  data -> vis [ style="bold"; penwidth=1; color="#006D2C" ] [ style="invis" ]
  vis:n -> diss:ne [ style="solid", color="#006D2C;0.1:#016A38;0.1:#026745;0.1:#036451;0.1:#04615E;0.1:#045D6A;0.1:#055A77;0.1:#065783;0.1:#075490;0.1:#08519C;0.1" ]
  vis:n -> data:ne [ style="solid", color="#006D2C" ]
{ rank=same; data, diss }
}
